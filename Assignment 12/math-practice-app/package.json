{
  "name": "math-practice-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages --base=./ --outDir dist-pages",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test && npm run typecheck && npm run build",
    "test:install": "node scripts/browser-tests.mjs install chromium firefox --no-shell",
    "test:e2e": "npm run build && node scripts/browser-tests.mjs test",
    "test:a11y": "npm run test:e2e -- accessibility.spec.ts",
    "test:pages": "npm run build:pages && node scripts/browser-tests.mjs test --config playwright.pages.config.ts",
    "test:e2e:headed": "npm run build && node scripts/browser-tests.mjs test --headed",
    "test:report": "node scripts/browser-tests.mjs show-report output/playwright/regression-report",
    "test:firefox": "npm run build && node scripts/browser-tests.mjs test --config playwright.firefox.config.ts",
    "check:all": "npm run check && node scripts/browser-tests.mjs test && npm run test:pages && node scripts/browser-tests.mjs test --config playwright.firefox.config.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
